# ─────────────────────────────────────────────────────────────────────────────
# HookShot — variables de entorno
# Copia este archivo a `.env` y ajusta los valores.
# ─────────────────────────────────────────────────────────────────────────────

# Puerto donde escucha el servidor (sirve API + frontend en producción).
PORT=3000

# Entorno: development | production
NODE_ENV=development

# ── Base de datos ────────────────────────────────────────────────────────────
# Cliente de Knex: "better-sqlite3" (dev por defecto) o "pg" (PostgreSQL en producción).
DB_CLIENT=better-sqlite3

# Ruta del archivo SQLite (solo si DB_CLIENT=sqlite3).
SQLITE_FILE=./data/hookshot.sqlite

# Cadena de conexión PostgreSQL (solo si DB_CLIENT=pg).
# Ejemplo: postgres://hookshot:hookshot@localhost:5432/hookshot
DATABASE_URL=

# ── Autenticación ────────────────────────────────────────────────────────────
# Secreto para firmar los JWT. CÁMBIALO en producción por algo largo y aleatorio.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
# Expiración del JWT emitido tras validar el PIN (formato de la lib `ms`).
JWT_EXPIRES=24h

# ── Retención / límites ──────────────────────────────────────────────────────
# Días que se conservan las peticiones capturadas antes de purgarlas.
RETENTION_DAYS=7
# Tamaño máximo (bytes) del body que se captura. 1048576 = 1 MB.
MAX_BODY_BYTES=1048576

# ── Demo mode ─────────────────────────────────────────────────────────────────
# Si está activo (true), permite crear webhooks sin PIN (expirados automáticamente).
DEMO_MODE=true
# Minutos de vida de un webhook demo antes de ser purgado.
DEMO_TTL_MINUTES=60
